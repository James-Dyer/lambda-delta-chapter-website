{
  "name": "my-app",
  "version": "0.1.0",
  "private": true,
  "homepage": "https://ucmsigmachi.org",
  "prettier": {
    "bracketSpacing": true,
    "printWidth": 80,
    "singleQuote": true,
    "trailingComma": "es5",
    "endOfLine": "lf"
  },
  "dependencies": {
    "framer-motion": "^12.17.0",
    "react": "^19.0.0",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.12.0",
    "web-vitals": "^4.2.4"
  },
  "scripts": {
    "start": "node scripts/convert-members.js && vite",
    "dev": "node scripts/convert-members.js && vite",
    "convert-members": "node scripts/convert-members.js",
    "build": "node scripts/convert-members.js && vite build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "predeploy": "branch=$(git rev-parse --abbrev-ref HEAD) && [ \"$branch\" = \"main\" ] || { echo \"Deploy blocked: current branch is '$branch'. Switch to 'main' to deploy.\"; exit 1; }; npm run build",
    "deploy": "gh-pages -d dist",
    "lint": "eslint src/ --ext .js,.jsx && prettier --check \"src/**/*.{js,jsx,css,json}\"",
    "format": "eslint src/ --ext .js,.jsx --fix && prettier --write \"src/**/*.{js,jsx,css,json}\""
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^9.27.0",
    "@vitejs/plugin-react": "^4.5.2",
    "@vitest/coverage-v8": "^3.2.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-react": "^7.37.5",
    "exceljs": "^4.4.0",
    "gh-pages": "^6.3.0",
    "globals": "^16.1.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.5.3",
    "vite": "^6.3.5",
    "vitest": "^3.2.0"
  }
}
